# PAPER CUP — API des demandes (Apache).
Options -Indexes
<FilesMatch "^(config\.local\.php|config\.sample\.php|\.user\.ini)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
